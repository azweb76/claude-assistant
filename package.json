{
  "name": "claude-assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @claude-assistant/shared build && pnpm -r --parallel --filter @claude-assistant/server --filter @claude-assistant/web run dev",
    "test": "pnpm --filter @claude-assistant/shared build && pnpm -r run test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm --filter @claude-assistant/shared build && pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @claude-assistant/server run db:generate",
    "db:migrate": "pnpm --filter @claude-assistant/server run db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
